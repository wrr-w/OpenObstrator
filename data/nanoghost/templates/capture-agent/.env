# =============================================================================
# NanoGhost 实例环境变量（capture-agent 模板）
# 留空的键继承全局 ~/.nanoghost/.env
# =============================================================================

# LLM 配置（覆盖全局）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_SUPPORTS_VISION=false

# Embedding 配置
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_LOCAL_MODEL=

# 飞书通道
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=
FEISHU_BOT_OPEN_ID=
LARK_CLI_PROFILE=
FEISHU_VERBOSE=false

# Agent 模式
AGENT_MODE=cli
AGENT_BASE_URL=http://127.0.0.1:8000

# 工作目录与 Prompt（capture 专属）
AGENT_WORKDIR=E:\OperationsAssistantORIG\Tech\Code\Capture
AGENT_PROMPTS_DIR=E:\OperationsAssistantORIG\Tech\Code\Capture\docs\prompts\2_agent
AGENT_NAMESPACE=capture

# 网络
NO_PROXY=*
